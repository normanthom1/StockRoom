# Copy to .env for local development. Never commit the real .env file.

# A long random string. python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-dev-only-key-change-me

# 1/true for local dev, 0/false in production
DEBUG=1

# Comma-separated. Not needed locally; required in production.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Falls back to a local SQLite file when unset. Railway provides this
# automatically when a Postgres service is attached.
DATABASE_URL=
