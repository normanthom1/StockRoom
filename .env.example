# Copy to .env for local development. Never commit the real .env file.

# A long random string. python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-dev-only-key-change-me

# 1/true for local dev, 0/false in production
DEBUG=1

# Comma-separated. Not needed locally; required in production.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Falls back to a local SQLite file when unset. Railway provides this
# automatically when a Postgres service is attached.
DATABASE_URL=

# 1 lets anyone set up a new practice at /accounts/signup/. Defaults to the
# opposite of DEMO_MODE below, so it's usually fine to leave unset.
SIGNUP_ENABLED=

# 1 turns on the public portfolio demo: one-click sign-in on the login page
# for the "Discover Dental" practice (run `python manage.py seed_demo` first), and a
# nightly reset with no separate cron service (see stockroom/demo.py).
DEMO_MODE=0

# A Google Gemini API key (aistudio.google.com) turns on Ask StockRoom (chat)
# and the paste-a-list / photo-of-an-invoice import. Leave empty to hide both.
# On the free tier, Google may use what's sent to improve its products.
AI_API_KEY=
# Any Gemini model with generateContent. AI_DAILY_LIMIT caps calls a day, across every practice.
AI_MODEL=gemini-2.5-flash
AI_DAILY_LIMIT=300

# Where the Django admin lives. Keep this out of a public repo's history in
# production - the default below is fine for local dev.
ADMIN_URL=platform/
